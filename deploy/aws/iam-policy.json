{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudVaultAppAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:CreateMultipartUpload",
        "s3:CompleteMultipartUpload",
        "s3:UploadPart"
      ],
      "Resource": [
        "arn:aws:s3:::cloudvault-storage-prod",
        "arn:aws:s3:::cloudvault-storage-prod/*"
      ]
    }
  ]
}
