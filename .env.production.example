# ═══════════════════════════════════════════════════════════════════════════════
# CloudVault — Production Environment Variables
# Copy to .env on your EC2 instance and fill in real values
# ═══════════════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── JWT Secrets (generate with: openssl rand -base64 64) ──────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
REFRESH_TOKEN_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_64
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=7d

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_USER=cloudvault
MONGO_PASSWORD=CHANGE_ME_strong_password_here
MONGODB_URI=mongodb://cloudvault:CHANGE_ME_strong_password_here@mongo:27017/cloudvault?authSource=admin

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_password_here
REDIS_URL=redis://:CHANGE_ME_strong_password_here@redis:6379

# ── AWS S3 ───────────────────────────────────────────────────────────────────
# Get these from deploy/aws/setup-s3.sh output
S3_ACCESS_KEY=YOUR_ACCESS_KEY_ID
S3_SECRET_KEY=YOUR_SECRET_ACCESS_KEY
S3_BUCKET=cloudvault-storage-prod
S3_REGION=us-east-1
S3_ENDPOINT=https://s3.us-east-1.amazonaws.com

# ── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ── Storage Quotas ───────────────────────────────────────────────────────────
DEFAULT_STORAGE_LIMIT=1073741824
# 1 GB per user (in bytes). Set higher for premium plans.

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://YOUR_DOMAIN.com

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
