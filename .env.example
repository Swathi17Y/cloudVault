# ======================
# CloudVault Environment
# ======================

# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/cloudvault

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_NAME=cloudvault-storage

# MinIO (Local Development - S3 compatible)
# Uncomment these for local development with MinIO
# S3_ENDPOINT=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_BUCKET_NAME=cloudvault

# Upload Settings
MAX_FILE_SIZE=524288000
CHUNK_SIZE=5242880
MAX_UPLOAD_CONCURRENCY=3
UPLOAD_SESSION_EXPIRY=86400

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# Storage
DEFAULT_STORAGE_LIMIT=1073741824

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
